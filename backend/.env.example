# Copia este archivo como .env y completa con tus valores reales.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore).

# Conexión a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/bubblepat_db
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres

# Clave de API Ninjas (https://api-ninjas.com) para el buscador de razas
API_NINJAS_KEY=tu_api_ninjas_key

# Secreto para firmar los tokens JWT (mínimo 256 bits para HS256)
JWT_SECRET=cadena-secreta-larga-y-aleatoria-para-jwt
