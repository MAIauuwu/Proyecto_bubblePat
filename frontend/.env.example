# El frontend ya no necesita variables de entorno para funcionar en desarrollo:
# consume la API a través del proxy de Vite (/api -> http://localhost:8081).
#
# Si despliegas en producción, define aquí la URL base pública del backend:
# VITE_API_BASE_URL=https://tu-backend.onrender.com/api
#
# En Render (Static Site), define esta misma variable en Environment.
