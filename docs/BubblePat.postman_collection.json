              "pm.collectionVariables.set('nextYearIso', ny.toISOString().substring(0,10));"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('PT-12a crear 200', () => pm.response.to.have.status(200));",
