  "item": [
    {
      "name": "1. Autenticación (PT-01..PT-04)",
      "item": [
        {
          "name": "PT-01 Registro de usuario válido (200 + JWT)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('newEmail', 'pt01_' + Date.now() + '@bubblepat.test');"] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('PT-01 status 200', () => pm.response.to.have.status(200));",
              "let j; try { j = pm.response.json(); } catch(e) { j = {}; }",
              "pm.test('PT-01 devuelve token JWT', () => pm.expect(j.token).to.be.a('string').and.not.empty);"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Usuario PT01\",\n  \"email\": \"{{newEmail}}\",\n  \"password\": \"Test1234\"\n}" }
          }
        },
        {
          "name": "PT-02 Registro email duplicado (400)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('PT-02 status 400', () => pm.response.to.have.status(400));",
              "let j; try { j = pm.response.json(); } catch(e) { j = {}; }",
              "let txt = JSON.stringify(j);",
              "pm.test('PT-02 mensaje email registrado', () => pm.expect(txt.toLowerCase()).to.include('registrado'));"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ana\",\n  \"email\": \"{{seedEmail}}\",\n  \"password\": \"Test1234\"\n}" }
          }
        },
        {
          "name": "PT-03 Login válido (200 + JWT) → guarda token Ana",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('PT-03 status 200', () => pm.response.to.have.status(200));",
